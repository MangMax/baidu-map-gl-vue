    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "prismjs": "^1.29.0",
    "vanilla-tilt": "^1.8.0",
    "vite-plugin-pwa": "^1.3.0",
    "baidu-map-gl-vue": "workspace:*",
    "zhlint": "^0.8.2",
    "chalk": "^4.1.2",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@baidumap/mapv-three": "^1.7.1",
    "bmap-draw": "^1.0.19",
