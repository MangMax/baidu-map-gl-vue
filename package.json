{
  "name": "vue3-baidu-map-gl-workspace",
  "description": "A Vue 3 baidu map gl Component Library. ",
  "version": "2.6.5",
  "scripts": {
    "test:unit": "vitest run tests/behavior tests/__smoke__.test.ts",
    "test:performance": "vitest run tests/performance",
    "verify:manifest": "node scripts/collect-api-manifest.mts --check",
    "verify:package": "node --experimental-strip-types scripts/verify-package.mts",
    "size:baseline": "node --experimental-strip-types scripts/collect-package-size.mts",
    "perf:baseline": "node --experimental-strip-types scripts/collect-performance-baseline.mts",
    "generate:manifest": "node --experimental-strip-types scripts/generate-manifest-artifacts.mts",
    "generate:manifest:check": "node --experimental-strip-types scripts/generate-manifest-artifacts.mts --check",
    "build:v3": "node --experimental-strip-types scripts/build-v3.mts",
    "typecheck:v3": "node --experimental-strip-types packages/vue3-baidu-map-gl/node_modules/.bin/vue-tsc -p packages/vue3-baidu-map-gl/tsconfig.build.json",
    "pack:v3": "pnpm --filter vue3-baidu-map-gl pack --pack-destination .artifacts",
    "playground:dev": "vp run -C apps/playground dev",
    "playground:build": "pnpm --filter playground build",
    "migrate": "node --experimental-strip-types scripts/migrate-v2-to-v3.mts",
    "changeset": "changeset"
  },
  "dependencies": {
    "mitt": "^3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "@types/ws": "^8.5.3",
    "@vue/compiler-sfc": "^3.3.4",
    "@vitejs/plugin-vue": "^5.1.2",
    "deepmerge": "^4.2.2",
    "fast-glob": "^3.2.12",
    "tslib": "^2.4.0",
    "typescript": "^4.8.4",
    "vite": "^6.4.0",
    "vue-tsc": "^1.6.5",
    "vitest": "^5.0.0",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.1",
    "@vue/test-utils": "^2.5.0",
    "@changesets/cli": "^3.0.2",
    "vite-plus": "0.3.0",
    "unplugin-vue": "^6.0.0",
    "vite-plugin-dts": "^5.1.0",
    "@microsoft/api-extractor": "^7.52.0",
    "@vue/language-core": "^2.2.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "pre-commit",
      "spawn-sync",
      "vue-demi"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "author": "MangMax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MangMax/baidu-map-gl-vue.git"
  }
}